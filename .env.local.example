# App
APP_ENV=local
APP_DEFAULT_LOCALE=es
APP_SUPPORTED_LOCALES=es,ca,va,gl,eu
APP_ENABLE_CROSS_LINGUAL_SEARCH=true
APP_SOURCE_QUOTE_POLICY=original_language
APP_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PUBLIC_PORT=8000

# PostgreSQL
POSTGRES_DB=procureai
POSTGRES_USER=procureai
POSTGRES_PASSWORD=procureai
POSTGRES_PUBLIC_PORT=55432
POSTGRES_DSN=postgresql://procureai:procureai@127.0.0.1:55432/procureai
POSTGRES_DSN_INTERNAL=postgresql://procureai:procureai@postgres:5432/procureai

# Milvus
MILVUS_URI=http://milvus:19530
MILVUS_PUBLIC_URI=http://your-private-host-ip:19530
MILVUS_HEALTH_URL=http://your-private-host-ip:9091/healthz
MILVUS_DB=procureai
MILVUS_USER=procureai
MILVUS_PASSWORD=change-me
MILVUS_TOKEN=procureai:change-me
MILVUS_COLLECTION=kb_chunks_v1
MILVUS_CONNECT_TIMEOUT_SECONDS=2
MILVUS_SEARCH_TIMEOUT_SECONDS=3
MILVUS_ENABLE_HYBRID=true
MILVUS_IMAGE=milvusdb/milvus:v2.5.17
MILVUS_ETCD_REQUEST_TIMEOUT_MS=60000
MILVUS_SESSION_TTL_SECONDS=300
MILVUS_SESSION_RETRY_TIMES=100

# Object storage: SeaweedFS S3 gateway already running on the host. Do not deploy MinIO for this stack.
OBJECT_STORAGE_ENDPOINT=http://host.docker.internal:8333
OBJECT_STORAGE_BUCKET=procureai
OBJECT_STORAGE_ACCESS_KEY=seaweedfs
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_REGION=eu-west-1
SEAWEEDFS_MASTER_URL=http://host.docker.internal:9333
SEAWEEDFS_FILER_URL=http://host.docker.internal:8888
SEAWEEDFS_S3_ADDRESS=host.docker.internal:8333

# Embeddings
EMBEDDING_API_URL=http://embedding-api-fast:8010
EMBEDDING_PUBLIC_PORT=8010
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=real
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_NORMALIZE=true
EMBEDDING_OPENAI_BASE_URL=
EMBEDDING_OPENAI_MODEL=bge-m3
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_RUNTIME=runc
NVIDIA_VISIBLE_DEVICES=void

# LLM
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=ver_modelo_real_en_destino
LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_TIMEOUT_SECONDS=300
LLM_STREAMING=true

# Retrieval
RETRIEVAL_TOP_K=80
RETRIEVAL_FINAL_K=24
RETRIEVAL_MAX_CHUNKS_PER_DOC=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
PCSP_WORKER_CPUS=2
PCSP_DOCUMENT_WORKER_THREADS=1
PCSP_DOCUMENT_WORKERS=1
PCSP_DOWNLOAD_SLEEP_SECONDS=0.05
PCSP_INDEX_MILVUS=false
PCSP_MILVUS_FLUSH_EVERY_BATCHES=20
PCSP_MILVUS_LOAD_AFTER_MONTH=false

# Actualización de normativa y doctrina desde fuentes oficiales autorizadas.
# CENDOJ no se automatiza sin acuerdo de reutilización.
OFFICIAL_SOURCE_CONNECTORS=boe,dogc,eurlex,eurlex_jurisprudencia,tccsp,tacrc
OFFICIAL_SOURCE_INTERVAL_HOURS=24
OFFICIAL_SOURCE_LIMIT=100
OFFICIAL_SOURCE_TENANT_ID=

# Security
AUTH_MODE=development_headers
# En cualquier APP_ENV no local usa AUTH_MODE=bearer, configura un secreto robusto y
# haz que el proxy de identidad inyecte X-User-Id, X-Tenant-Id y X-Roles.
API_AUTH_BEARER_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=change-me
